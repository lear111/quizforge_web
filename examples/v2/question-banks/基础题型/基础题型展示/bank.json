          },
          {
            "id": "table-3",
            "content": "<table><tr><th><p>x</p></th><th><p>2</p></th><th><p>3</p></th></tr><tr><td><p>y</p></td><td><p>2</p></td><td><p>3</p></td></tr></table>"
