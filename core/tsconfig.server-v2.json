{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "server/v2/repositories/**/*.js",
    "server/v2/services/**/*.js",
    "server/v2/types/**/*.d.ts"
  ]
}
