{
  "name": "quizforge-web-local",
  "version": "0.1.0-preview.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Native Node.js QuizForge host, extension rule runner and browser checks",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node server/v2-main.mjs --root ..",
    "build:richtext": "node scripts/build/build-richtext.mjs",
    "build:richtext-advanced": "node scripts/build/build-richtext-advanced.mjs",
    "build:short-answer-advanced": "node scripts/build/build-short-answer-advanced.mjs",
    "build:short-answer-ai": "node scripts/build/build-short-answer-ai.mjs",
    "test": "node scripts/test/run.mjs",
    "test:host": "node scripts/test/run.mjs host",
    "test:perf": "node scripts/test/run.mjs perf",
    "build:ui": "node scripts/build/build-ui.mjs",
    "typecheck:ui": "vue-tsc --project frontend/tsconfig.json --noEmit",
    "format:check": "node scripts/quality/format.mjs",
    "format:v2": "node scripts/quality/format.mjs --write",
    "lint": "node scripts/quality/lint.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.12",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-color": "3.31.4",
    "@tiptap/extension-font-family": "3.31.4",
    "@tiptap/extension-highlight": "3.31.4",
    "@tiptap/extension-mathematics": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/extension-subscript": "3.31.4",
    "@tiptap/extension-superscript": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/extension-text-style": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "express": "5.3.0",
    "html2canvas": "1.4.1",
    "katex": "0.16.43",
    "pinia": "4.1.0",
    "qrcode-generator": "2.0.4",
    "vue-router": "5.5.1",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "jsdom": "27.4.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vue": "3.5.45",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  }
}
