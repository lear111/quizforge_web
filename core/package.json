{
  "name": "quizforge-web-local",
  "version": "0.1.0-preview.4",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Native Node.js QuizForge host, extension rule runner and browser checks",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node server/main.mjs --root ..",
    "build:richtext": "node scripts/build/build-richtext.mjs",
    "build:richtext-advanced": "node scripts/build/build-richtext-advanced.mjs",
    "build:short-answer-advanced": "node scripts/build/build-short-answer-advanced.mjs",
    "build:short-answer-ai": "node scripts/build/build-short-answer-ai.mjs",
    "test": "node scripts/test/run.mjs",
    "test:host": "node scripts/test/run.mjs host",
    "test:rules": "node scripts/test/run.mjs rules"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.12",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-color": "3.31.4",
    "@tiptap/extension-font-family": "3.31.4",
    "@tiptap/extension-highlight": "3.31.4",
    "@tiptap/extension-mathematics": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/extension-subscript": "3.31.4",
    "@tiptap/extension-superscript": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/extension-text-style": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "html2canvas": "1.4.1",
    "katex": "0.16.43",
    "qrcode-generator": "2.0.4",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "jsdom": "27.4.0"
  }
}
