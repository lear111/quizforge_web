    "documentProfile": "advanced-v1",
    "capabilities": [
      "basic-formatting",
      "images",
      "advanced-formatting",
      "tables",
      "math",
      "image-resize"
    ]
  },
  "entry": "practice.html",
  "script": "practice.js",
  "style": "practice.css",
  "rules": "rules.js",
  "questionSchema": "question.schema.json",
  "answerSchema": "answer.schema.json",
  "examples": "examples/bank.json"
}
