    {
      "id": "sample-image-math",
      "title": "单问：图片与公式",
      "data": {
        "formatVersion": 1,
        "material": null,
        "parts": [
          {
            "id": "area",
            "stem": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "如图，直角三角形的两条直角边分别为 "
                    },
                    {
                      "type": "inlineMath",
                      "attrs": {
                        "latex": "3\\,\\mathrm{cm}"
                      }
                    },
                    {
                      "type": "text",
                      "text": " 和 "
                    },
                    {
                      "type": "inlineMath",
                      "attrs": {
                        "latex": "4\\,\\mathrm{cm}"
                      }
                    },
                    {
                      "type": "text",
                      "text": "。请计算它的面积，并写出计算过程。"
                    }
                  ]
                },
                {
                  "type": "image",
                  "attrs": {
                    "assetId": "96fbe7bbe9e76622b6236d0d0fbfddb92f022249ac38bdbbd908efd3bf3791a8",
                    "alt": "直角三角形，两条直角边分别为3厘米和4厘米",
                    "width": 360,
                    "align": "left"
                  }
                }
              ]
            },
            "answerAndExplanation": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "三角形面积等于底乘高的一半："
                    }
                  ]
                },
                {
                  "type": "blockMath",
                  "attrs": {
                    "latex": "S=\\frac{1}{2}\\times3\\times4=6\\,\\mathrm{cm}^2"
                  }
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "评分参考：公式与过程正确 3 分；结果及单位正确 2 分。"
                    }
                  ]
                }
              ]
            },
            "maxScore": 5
          }
        ]
      }
    },
