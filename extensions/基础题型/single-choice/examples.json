      "id": "example-inclusive-boundary",
      "title": "判断边界",
      "data": {
        "stem": "某测验规定分数达到 60 分即为及格。若变量 score 保存分数，以下哪一个条件准确表达“及格”？",
        "options": [{ "id": "A", "text": "score > 60" }, { "id": "B", "text": "score >= 60" }, { "id": "C", "text": "score == 60" }, { "id": "D", "text": "score < 60" }],
        "correctOptionId": "B",
        "explanation": "“达到 60 分”包含恰好等于 60 的情况，所以应使用大于或等于。只写大于会漏掉边界值，只写等于则会漏掉高于 60 的分数。",
        "maxScore": 1
      }
    },
