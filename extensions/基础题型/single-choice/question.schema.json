{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "单选题数据",
  "type": "object",
  "additionalProperties": false,
  "required": ["stem", "options", "correctOptionId", "explanation", "maxScore"],
  "properties": {
    "stem": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 26,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "maxLength": 64 },
          "text": { "type": "string", "minLength": 1, "maxLength": 10000 }
        }
      }
    },
    "correctOptionId": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "maxLength": 64 },
    "explanation": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "maxScore": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000 }
  }
}
