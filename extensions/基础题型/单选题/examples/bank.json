                  ]
                }
              ]
            }
          }
        ],
        "correctOptionId": "choice-6",
        "answerAndExplanation": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "6 是偶数。",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "偶数能被 2 整除。6 ÷ 2 = 3，其余三个数除以 2 都有余数。"
                }
              ]
            }
          ]
        },
        "maxScore": 2
